# Copy to .env only if you want to remember your own values. NEVER commit real secrets.
# There are NO access keys here on purpose: Lambda uses an IAM role, and your PC uses "aws configure".
AWS_REGION=ap-south-1
DYNAMODB_STUDENTS_TABLE=Students
DYNAMODB_BOOKS_TABLE=Books
DYNAMODB_HISTORY_TABLE=ReadingHistory
S3_BUCKET_NAME=
API_BASE_URL=
